generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")            // runtime: pooler transaction (6543)
  directUrl = env("DIRECT_DATABASE_URL")     // migrations/CLI: sessão (5432) ou direta
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String
  price       Decimal
  images      String    // JSON array de paths (SQLite não suporta String[])
  stock       Int       @default(1)
  featured    Boolean   @default(false)
  available   Boolean   @default(true)
  weight      Float     @default(2.0)
  width       Float     @default(30)
  height      Float     @default(20)
  length      Float     @default(20)
  createdAt   DateTime  @default(now())
  categories  Category[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  products  Product[]
}

model Workshop {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String
  date         DateTime
  duration     Int
  price        Decimal
  location     String
  maxAttendees Int
  spotsTaken   Int      @default(0)
  image        String?
  active       Boolean  @default(true)
}

model CustomOrder {
  id            String   @id @default(cuid())
  name          String
  contact       String
  description   String
  images        String   @default("[]") // JSON array de URLs
  referenceSlug String?
  referenceName String?
  status        String   @default("nova")
  createdAt     DateTime @default(now())
}

// Contador de rate limit por janela fixa, compartilhado entre instâncias
// serverless. id = `${chave}:${inicioDaJanela(ms)}`; expiresAt permite limpar
// linhas antigas.
model RateLimit {
  id        String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model Order {
  id            String   @id @default(cuid())
  name          String
  contact       String
  items         String   // JSON array de [{slug,name,qty,unitPrice}] (SQLite não suporta Json)
  total         Decimal
  status        String   @default("recebido")
  paymentMethod String?  // "whatsapp" | "mercadopago"
  paymentStatus String?  // status bruto do Mercado Pago (approved, pending, rejected, ...)
  preferenceId  String?  // id da preferência Checkout Pro no Mercado Pago
  paymentId     String?  // id do pagamento no Mercado Pago
  deliveryMethod    String   @default("envio")
  addressEmail      String   @default("")
  addressCep        String   @default("")
  addressRua        String   @default("")
  addressNumero     String   @default("")
  addressCompl      String   @default("")
  addressRef        String   @default("")
  addressBairro     String   @default("")
  addressCidade     String   @default("")
  addressUf         String   @default("")
  shippingServiceId String?
  shippingServiceName String?
  shippingPrice     Decimal?
  shippingEta       Int?
  createdAt     DateTime @default(now())
}
